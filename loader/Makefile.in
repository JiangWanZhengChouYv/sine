SOURCES = \
	main.c \
	preloader.c \
	preloader_mac.c \
	wine.desktop \
	wine.inf.in \
	wine_info.plist.in

PROGRAMS = $(WINELOADER_PROGRAMS)
INSTALL_LIB = $(WINELOADER_PROGRAMS)
UNIX_CFLAGS = -fPIE

preloader_EXTRADEFS = -fno-builtin

sine_OBJS = main.o
sine_DEPS = $(WINELOADER_DEPENDS)
sine_LDFLAGS = $(WINELOADER_LDFLAGS) $(LDEXECFLAGS) $(PTHREAD_LIBS)

sine_preloader_OBJS = preloader.o preloader_mac.o
sine_preloader_DEPS = $(WINELOADER_DEPENDS)
sine_preloader_LDFLAGS = $(WINEPRELOADER_LDFLAGS)
